# Copy this file to .env.local and fill in the values you have.
# Every one of these is optional - the site works and builds fine with none set,
# each feature just falls back to a safe default or stays hidden until configured.

# Real scheduling link (Calendly, Cal.com, etc). Falls back to a mailto: link
# to hello@gearon.ai when unset. Used by components/BookCall.tsx and
# components/BookingWidget.tsx via BOOKING_URL in lib/data.ts.
NEXT_PUBLIC_BOOKING_URL=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Analytics stays off entirely when unset.
# Used by components/Analytics.tsx.
NEXT_PUBLIC_GA_ID=

# WhatsApp number in international format, digits only, no + or spaces
# (e.g. 8801XXXXXXXXX). The floating chat button is hidden when unset.
# Used by components/WhatsAppButton.tsx.
# Note: the homepage is statically generated, so this must be set at BUILD
# time (in your hosting provider's env config), not just at runtime.
NEXT_PUBLIC_WHATSAPP_NUMBER=
